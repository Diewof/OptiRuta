# Configuracion de la app OptiRuta.
#
# Estos valores se pasan al build con --dart-define, no se leen en runtime:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_ANON_KEY=$SUPABASE_ANON_KEY
#
# Copia este archivo a .env y completa los valores. .env NO se versiona.

# URL del proyecto Supabase (Settings -> API -> Project URL).
# Ej.: https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Clave anonima / "anon public" (Settings -> API -> Project API keys -> anon).
# Es publica por diseno; la seguridad la dan las politicas RLS.
SUPABASE_ANON_KEY=

# --- NO incluir en la app ---
# La service_role key vive solo como secreto del proyecto Supabase / de las
# Edge Functions. Nunca se compila en el cliente.
#
# Secretos de Edge Functions (se configuran con `supabase secrets set`, no
# aqui; GOPASS_WEBHOOK_SECRET es para referencia futura):
#   GOPASS_WEBHOOK_SECRET       -> clave de servicio del webhook de peajes GoPass
#   (rutas no usa secretos: Photon y OSRM son publicos y sin API key)
#   PRECIO_ACPM_SCRAPER_SECRET  -> clave de servicio de precio-acpm-scraper
#                                  (cabecera x-service-secret). El mismo valor
#                                  se guarda en Supabase Vault como el secreto
#                                  "precio_acpm_scraper_secret" para que
#                                  pg_cron pueda mandarlo al invocar la funcion.

# Nota: para un Supabase local (opcional, requiere Docker) seria
#   SUPABASE_URL=http://127.0.0.1:54321   (o http://10.0.2.2:54321 en emulador Android)
